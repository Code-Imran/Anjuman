---
import { reader } from '../lib/keystatic-reader';

interface Props {
  phone1?: string;
  phone2?: string;
  email?: string;
}

const settings = await reader.singletons.siteSettings.read();

const {
  phone1 = settings?.phone1 || '8275204302',
  phone2 = settings?.phone2 || '8275205404',
  email = settings?.email || 'anjumanpanchgani@gmail.com',
} = Astro.props;

const year = new Date().getFullYear();
---

<!-- Footer: Deep Midnight Navy #0d1b2a with Crimson Red #8b1d2c Accent Strip -->
<footer class="bg-[#0d1b2a] border-t-4 border-[#8b1d2c] pt-16 pb-10 px-6 text-slate-300">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12">
    
    <!-- Section 1: Brand & Affiliation Details -->
    <div class="flex flex-col justify-between space-y-6">
      <div>
        <a href="/" class="flex items-center gap-3.5 group no-underline">
          <img
            src="/images/logo.webp"
            alt="Anjuman-I-Islam Crest Logo"
            width="48"
            height="48"
            class="w-12 h-12 object-contain shrink-0 group-hover:scale-105 transition-transform duration-200"
            loading="lazy"
          />
          <div>
            <h3 class="font-serif text-lg lg:text-xl font-bold text-white tracking-tight leading-tight">
              ANJUMAN-I-ISLAM
            </h3>
            <p class="text-xs uppercase tracking-widest font-semibold text-red-200 mt-0.5">
              Public School &amp; Jr. College
            </p>
          </div>
        </a>
        
        <p class="text-sm text-slate-400 leading-relaxed mt-4">
          Maharashtra State Board Affiliated (SSC &amp; HSC Board) Residential Co-Ed School in Panchgani, Established in 1920.
        </p>

        <div class="mt-4 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-red-200">
          <span class="w-2 h-2 rounded-full bg-[#8b1d2c]"></span>
          Nurturing Young Minds Since 1920
        </div>
      </div>

      <div class="pt-4">
        <!-- Crimson Red Admission CTA Button -->
        <a
          href="/admission#apply-now"
          class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-[13px] font-bold text-white bg-[#8b1d2c] hover:bg-[#721522] rounded-full transition-all duration-200 shadow-sm hover:shadow-md active:scale-[0.98]"
        >
          <span>Apply for Admission</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Section 2: Contact Information & Tap-to-Call Actions -->
    <div>
      <h4 class="font-serif text-base lg:text-lg font-bold text-white tracking-tight mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#8b1d2c]"></span>
        Contact Us
      </h4>

      <div class="space-y-4 text-sm text-slate-400">
        <!-- Call Buttons (Pill-shaped Univet style) -->
        <div class="flex flex-wrap gap-2.5 pt-1 pb-1">
          <a
            href={`tel:${phone1}`}
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-[#8b1d2c] hover:bg-[#721522] rounded-full transition-all duration-200 shadow-sm hover:shadow active:scale-[0.98]"
            title={`Click to call ${phone1}`}
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Call {phone1}</span>
          </a>

          {phone2 && (
            <a
              href={`tel:${phone2}`}
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold text-slate-200 bg-slate-800 hover:bg-slate-700 rounded-full transition-all duration-200 border border-slate-700/80 active:scale-[0.98]"
              title={`Click to call ${phone2}`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
              <span>Call {phone2}</span>
            </a>
          )}
        </div>

        <p class="flex items-start gap-2">
          <strong class="text-slate-200 font-semibold shrink-0">Address:</strong>
          <span>412805, Panchgani, Satara District, Maharashtra, India</span>
        </p>

        <p class="flex items-center gap-2">
          <strong class="text-slate-200 font-semibold shrink-0">Office Hours:</strong>
          <span>Mon. &ndash; Sat. : 9:00 AM &ndash; 5:00 PM</span>
        </p>

        <p class="flex items-center gap-2">
          <strong class="text-slate-200 font-semibold shrink-0">Email:</strong>
          <a href={`mailto:${email}`} class="text-red-300 hover:text-white transition-colors underline underline-offset-4 decoration-red-300/40 break-all">
            {email}
          </a>
        </p>
      </div>
    </div>

    <!-- Section 3: Campus Location Google Map Embed -->
    <div>
      <h4 class="font-serif text-base lg:text-lg font-bold text-white tracking-tight mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#8b1d2c]"></span>
        Campus Location
      </h4>
      
      <div class="w-full h-52 rounded-3xl overflow-hidden border border-slate-700/60 shadow-md bg-slate-900 relative">
        <iframe
          title="Anjuman-I-Islam Public School Panchgani Campus Location"
          src="https://www.google.com/maps?sca_esv=c3fa94b0e0973b9d&rlz=1C1CFYW_en-GBIN1175IN1175&output=embed&q=anjuman-i-islam+public+school+panchgani"
          class="w-full h-full border-0 absolute inset-0"
          loading="lazy"
          allowfullscreen=""
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>

  </div>

  <!-- Bottom Legal & Attribution Strip -->
  <div class="max-w-6xl mx-auto mt-12 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
    <p>
      Anjuman Public School &ndash; Web Architecture by{' '}
      <a
        href="https://www.linkedin.com/in/imran-shaikh-webdeveloper/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white hover:text-red-300 font-medium underline underline-offset-4 decoration-red-400/50 transition-colors"
      >
        Imran Shaikh
      </a>
    </p>
    <div class="flex items-center gap-5 text-slate-500">
      <a href="/admission#rules-regulations" class="hover:text-slate-300 transition-colors">Statutory Policies</a>
      <a href="/contact" class="hover:text-slate-300 transition-colors">Directions</a>
      <a href="/login" class="hover:text-slate-300 transition-colors">Staff Login</a>
    </div>
  </div>
</footer>