---
const stats = [
  {
    target: 275186,
    display: "275,186",
    unit: "Square Meters",
    label: "Sprawling Campus",
  },
  {
    target: 10000,
    display: "10,000+",
    unit: "Successful Alumni",
    label: "Global Community",
  },
  {
    target: 60,
    display: "60+",
    unit: "Experienced Staff",
    label: "Dedicated Mentors",
  },
  {
    target: 100,
    display: "100+",
    unit: "Years of Foundation",
    label: "Panchgani Legacy",
  },
];
---

<section class="bg-[#0f2b1d] border-y border-[#1a4230] py-14 relative overflow-hidden" aria-label="Key Institutional Statistics">
  <!-- Subtle decorative ambient glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(194,139,30,0.08),_transparent_70%)] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      {stats.map((stat) => (
        <div class="group bg-white/[0.03] hover:bg-white/[0.07] border border-white/10 hover:border-[#c28b1e] rounded-lg p-6 transition-all duration-300 transform hover:-translate-y-1.5 shadow-sm hover:shadow-xl">
          <p
            class="stat-counter font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#f7d070] tracking-tight leading-none group-hover:scale-105 transition-transform duration-300"
            data-target={stat.target}
            data-display={stat.display}
          >
            {stat.display}
          </p>
          <p class="mt-3 text-base font-bold text-white tracking-wide">
            {stat.unit}
          </p>
          <p class="mt-1 text-xs sm:text-sm text-[#9bb3a6] font-medium uppercase tracking-wider">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = Number(el.getAttribute('data-target') || '0');
          const finalDisplay = el.getAttribute('data-display') || target.toString();
          
          let start = 0;
          const duration = 1600;
          const stepTime = 20;
          const totalSteps = duration / stepTime;
          const increment = target / totalSteps;

          const timer = setInterval(() => {
            start += increment;
            if (start >= target) {
              clearInterval(timer);
              el.textContent = finalDisplay;
            } else {
              el.textContent = Math.floor(start).toLocaleString();
            }
          }, stepTime);

          obs.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    counters.forEach((c) => observer.observe(c));
  }

  setupCounters();
</script>