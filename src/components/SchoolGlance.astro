---
const stats = [
  { value: "1920", label: "Year founded" },
  { value: "100+", label: "Years of legacy" },
  { value: "ICSE", label: "Curriculum board" },
  { value: "Co-Ed", label: "Residential campus" },
];
---

<section class="bg-slate-900 border-y border-slate-800 py-10">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
    {stats.map((stat) => (
      <div>
        <p class="font-serif text-3xl md:text-4xl text-amber-400">{stat.value}</p>
        <p class="mt-1 text-sm text-slate-400">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
