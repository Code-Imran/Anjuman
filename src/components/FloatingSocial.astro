---
interface Props {
  phone?: string;
}

const { phone = "8275204302" } = Astro.props;
---

<!-- Floating Quick-Action Widget -->
<aside class="fixed bottom-6 right-6 z-50 flex flex-col gap-3" aria-label="Quick contact links">
  <!-- WhatsApp Quick Chat -->
  <a
    href={`https://wa.me/91${phone}?text=Hello%2C%20I%20would%20like%20to%20enquire%20about%20admissions.`}
    target="_blank"
    rel="noopener noreferrer"
    class="w-12 h-12 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200"
    title="Chat on WhatsApp"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.813 2.796.814 3.183 0 5.768-2.587 5.769-5.766.001-3.182-2.585-5.766-5.769-5.766zm3.385 8.165c-.141.396-.814.757-1.127.808-.314.052-.705.077-2.046-.479-1.637-.678-2.678-2.355-2.759-2.463-.081-.108-.66-8.79-.66-1.677 0-.797.417-1.189.566-1.348.149-.158.326-.198.435-.198.109 0 .218.001.314.006.101.005.236-.039.369.281.141.341.48 1.171.522 1.258.042.086.07.187.014.3-.056.113-.085.183-.17.282-.085.099-.178.221-.254.298-.085.086-.174.179-.075.349.099.17.441.728.948 1.179.652.581 1.203.762 1.374.848.17.086.27.072.37-.043.1-.114.426-.497.54-.667.113-.17.227-.142.381-.085.155.057.986.465 1.156.55.17.085.284.128.326.198.042.07.042.41-.099.807z"/>
    </svg>
  </a>

  <!-- Phone Call Quick Action -->
  <a
    href={`tel:${phone}`}
    class="w-12 h-12 rounded-full bg-[#8b1d2c] text-white flex items-center justify-center shadow-lg hover:scale-110 active:scale-95 transition-transform duration-200"
    title="Call Admissions"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
  </a>
</aside>
