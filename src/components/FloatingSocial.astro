---
interface Props {
  phone?: string;
}
const { phone = "" } = Astro.props;
const waNumber = phone.replace(/\D/g, "");
---

<div class="fixed bottom-6 right-6 z-40 flex flex-col gap-3">
  {waNumber && (
    <a
      href={`https://wa.me/91${waNumber}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="w-12 h-12 rounded-full bg-green-600 flex items-center justify-center shadow-lg hover:bg-green-500 transition-colors"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
        <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.07-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm0 18c-1.6 0-3.1-.42-4.4-1.16l-.31-.18-3.02.79.8-2.94-.2-.32A7.98 7.98 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8z"/>
      </svg>
    </a>
  )}
  {phone && (
    <a
      href={`tel:${phone}`}
      aria-label="Call the school"
      class="w-12 h-12 rounded-full bg-amber-500 flex items-center justify-center shadow-lg hover:bg-amber-400 transition-colors"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.94.36 1.86.67 2.75a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.33-1.24a2 2 0 0 1 2.11-.45c.89.31 1.81.54 2.75.67A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  )}
</div>
