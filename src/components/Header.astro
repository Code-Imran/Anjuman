---
import { reader } from '../lib/keystatic-reader';

interface Props {
  phone1?: string;
  phone2?: string;
  email?: string;
}

const settings = await reader.singletons.siteSettings.read();

const {
  phone1 = settings?.phone1 ?? '',
  phone2 = settings?.phone2 ?? '',
  email = settings?.email ?? '',
} = Astro.props;

const navLinks =
  settings?.navLinks && settings.navLinks.length > 0
    ? settings.navLinks
    : [
        { label: 'Home', href: '/' },
        { label: 'About', href: '/about' },
        { label: 'Admissions', href: '/admission-requirements' },
        { label: 'Contact', href: '/contact' },
      ];
---

<header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur border-b border-amber-700/30">
  <div class="hidden sm:flex justify-end gap-6 px-6 py-1.5 text-xs text-slate-300 border-b border-slate-800">
    {phone1 && <a href={`tel:${phone1}`} class="hover:text-amber-400">{phone1}</a>}
    {phone2 && <a href={`tel:${phone2}`} class="hover:text-amber-400">{phone2}</a>}
    {email && <a href={`mailto:${email}`} class="hover:text-amber-400">{email}</a>}
  </div>

  <div class="flex items-center justify-between px-6 py-3 max-w-7xl mx-auto">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.webp" alt="Anjuman-I-Islam School crest" class="h-10 w-10 object-contain" onerror="this.style.display='none'" />
      <span class="font-serif text-lg leading-tight text-white">
        Anjuman-I-Islam<br />
        <span class="text-xs font-sans text-amber-400 tracking-wide">Panchgani, since 1920</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm text-slate-200 hover:text-amber-400 transition-colors">
          {link.label}
        </a>
      ))}
      <a href="/login" class="text-sm px-4 py-2 rounded border border-amber-600 text-amber-400 hover:bg-amber-600 hover:text-slate-900 transition-colors">
        Staff Login
      </a>
    </nav>

    <button id="menu-toggle" class="md:hidden text-white" aria-label="Open menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden flex-col gap-1 px-6 pb-4">
    {navLinks.map((link) => (
      <a href={link.href} class="block py-2 text-slate-200 hover:text-amber-400">{link.label}</a>
    ))}
    <a href="/login" class="block py-2 text-amber-400">Staff Login</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>
