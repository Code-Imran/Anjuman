---
const pillars = [
  {
    tag: "01",
    title: "Community",
    desc: "A co-ed with Inclusivity and Diversity, Global Perspective, Relationships for Lifelong Learning.",
  },
  {
    tag: "02",
    title: "Affiliation",
    desc: "Explore wide range of innovative and essential courses offered by SSC & HSC boards.",
  },
  {
    tag: "03",
    title: "Our Offerings",
    desc: "Pre-Primary to XII Science with Coaching for NEET, JEE, MH-CET and NATA.",
  },
  {
    tag: "04",
    title: "Growth beyond classrooms",
    desc: "Activity based learning in Robotics, Artificial Intelligence (AI), Basic aviation, Agriculture, Archery, Gardening.",
  },
];
---

<section class="py-20 px-6 bg-[#f4f8f5] border-b border-[#e2e8e4]" aria-label="Co-Curricular Life and Institutional Pillars">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-[#c28b1e] bg-[#c28b1e]/10 px-3 py-1 rounded mb-3">
        Holistic Development
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-[#103020] tracking-tight">
        Co-Curricular Life
      </h2>
      <p class="mt-2 text-sm sm:text-base text-gray-600">
        Nurturing intellectual, moral, and physical vitality through structured exploration and foundational values.
      </p>
    </div>

    <!-- 4 Pillar Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar) => (
        <div class="bg-white border-2 border-[#103020] rounded-none p-6 sm:p-7 flex flex-col justify-between shadow-[0_4px_16px_rgba(16,48,32,0.05)] hover:shadow-[0_12px_28px_rgba(16,48,32,0.12)] hover:-translate-y-1.5 transition-all duration-300 group">
          <div>
            <!-- Top Tag & Decorative Dot -->
            <div class="flex items-center justify-between mb-5 border-b border-gray-100 pb-3">
              <span class="font-serif text-2xl font-black text-[#c28b1e] group-hover:scale-110 transition-transform">
                {pillar.tag}
              </span>
              <div class="w-2 h-2 rounded-full bg-[#103020] group-hover:bg-[#c28b1e] transition-colors"></div>
            </div>

            <!-- Card Title -->
            <h3 class="font-serif text-xl font-bold text-[#103020] group-hover:text-[#c28b1e] transition-colors leading-snug">
              {pillar.title}
            </h3>

            <!-- Card Description -->
            <p class="mt-3 text-sm text-gray-700 leading-relaxed">
              {pillar.desc}
            </p>
          </div>

          <!-- Bottom Footer Accent -->
          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
              Anjuman Pillars
            </span>
            <span class="text-[#c28b1e] text-xs font-bold group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>