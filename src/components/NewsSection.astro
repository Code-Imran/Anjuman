---
import { reader } from '../lib/keystatic-reader';

interface Post {
  title: string;
  date: string;
  category: string;
  excerpt: string;
  slug: string;
  image: string;
}
interface Props {
  recentPosts?: Post[];
}

let { recentPosts } = Astro.props;

if (!recentPosts) {
  const entries = await reader.collections.news.all();
  recentPosts = entries
    .map((e) => ({
      title: e.entry.title,
      date: e.entry.date,
      category: e.entry.category,
      excerpt: e.entry.excerpt,
      slug: e.slug,
      image: e.entry.image,
    }))
    .sort((a, b) => (a.date < b.date ? 1 : -1));
}
---

<section class="py-16 px-6 bg-slate-950">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-serif text-2xl md:text-3xl text-white">Campus News</h2>
    <p class="mt-2 text-slate-400">What's happening at Anjuman-I-Islam.</p>

    <div class="mt-10 grid md:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <article class="rounded-lg overflow-hidden bg-slate-900 border border-slate-800 hover:border-amber-600/50 transition-colors">
          <img src={post.image} alt={post.title} class="w-full h-40 object-cover" onerror="this.style.display='none'" />
          <div class="p-5">
            <p class="text-xs text-amber-400">{post.category} · {post.date}</p>
            <h3 class="mt-2 font-serif text-lg text-white leading-snug">{post.title}</h3>
            <p class="mt-2 text-sm text-slate-400">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
