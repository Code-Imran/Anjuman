---
interface Props {
  phone?: string;
}
const { phone = "" } = Astro.props;
---

<section class="py-16 px-6">
  <div class="max-w-4xl mx-auto text-center rounded-xl border border-amber-700/40 bg-slate-900 p-10">
    <h2 class="font-serif text-2xl md:text-3xl text-white">Admissions Open</h2>
    <p class="mt-3 text-slate-400 max-w-lg mx-auto">
      Join a century-old tradition of academic excellence in Panchgani. Enquire about seats
      for the upcoming academic year.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a href="/admission-requirements" class="px-6 py-3 rounded bg-amber-500 text-slate-900 font-medium hover:bg-amber-400 transition-colors">
        View Admission Requirements
      </a>
      {phone && (
        <a href={`tel:${phone}`} class="px-6 py-3 rounded border border-slate-700 text-white hover:border-amber-500 transition-colors">
          Call {phone}
        </a>
      )}
    </div>
  </div>
</section>
