---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const phone1 = "8275204302";
const phone2 = "8275205404";
const email = "anjumanpanchgani@gmail.com";
---

<BaseLayout
  title="Careers | Anjuman-I-Islam Public School & Jr. College, Panchgani"
  description="Explore career opportunities at Anjuman-I-Islam Public School & Jr. College, Panchgani. Join our faculty and staff in a legacy residential institution."
>
  <Header phone1={phone1} phone2={phone2} email={email} />

  <!-- Hero Banner -->
  <section class="bg-[#0f2b1d] border-b border-[#1a4230] py-16 md:py-20 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#f7d070] bg-white/[0.08] border border-white/10 px-3 py-1 rounded mb-3">
        Work With Us
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Join Us for a Bright Career
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Be a part of a historic residential institution shaping the academic and moral foundation of future leaders in Panchgani.
      </p>
    </div>
  </section>

  <main class="py-16 md:py-20 bg-[#f8faf9]">
    <div class="max-w-5xl mx-auto px-6 space-y-12">

      <!-- Legacy & Academic Excellence Overview -->
      <div class="bg-white border-2 border-[#103020] p-8 sm:p-10 shadow-[0_8px_24px_rgba(16,48,32,0.06)]">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#c28b1e] bg-[#c28b1e]/10 px-3 py-1 rounded inline-block mb-3">
          Our Heritage & Environment
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#103020] tracking-tight mb-4">
          A Century of Educational Distinction
        </h2>
        <p class="text-sm sm:text-base text-gray-700 leading-relaxed text-justify">
          Established in 1920, Anjuman-I-Islam Public School & Jr. College carries over a century of educational tradition set against the scenic hills of Panchgani. With our comprehensive academic structure spanning foundational schooling through to our Junior College offering both Science and Commerce streams, we provide an intellectually stimulating environment designed for scholastic rigor and personal growth. Our institution prides itself on cultivating a supportive, inclusive work culture where dedicated educators and professional staff collaborate harmoniously. Members of our team enjoy an enriching community life, opportunities for professional advancement, and the rewarding privilege of mentoring students within a celebrated residential campus.
        </p>
      </div>

      <!-- Direct Web3Forms Career Application Form -->
      <div class="bg-white border-2 border-[#103020] p-8 sm:p-10 shadow-[0_8px_24px_rgba(16,48,32,0.06)]">
        <div class="mb-8">
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#c28b1e] bg-[#c28b1e]/10 px-3 py-1 rounded inline-block mb-2">
            Apply Online
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#103020] tracking-tight">
            Submit Your Application
          </h2>
          <p class="mt-1 text-sm text-gray-600">
            Fill out the form below. Please include details about your qualifications and the position you are applying for.
          </p>
        </div>

        <form id="career-form" class="space-y-5">
          <input type="hidden" name="access_key" value="927b4f37-3d99-458b-924c-1ff5af739f20" />
          <input type="hidden" name="subject" value="New Job Application - Anjuman Panchgani Careers" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Row 1: Name & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                Full Name <span class="text-[#9b1b2e]">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Enter your full name"
                class="w-full px-3.5 py-2.5 text-sm bg-[#fdfdfd] border border-gray-300 rounded-none outline-none focus:border-[#103020] focus:ring-1 focus:ring-[#103020] transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                Email Address <span class="text-[#9b1b2e]">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="Enter your email address"
                class="w-full px-3.5 py-2.5 text-sm bg-[#fdfdfd] border border-gray-300 rounded-none outline-none focus:border-[#103020] focus:ring-1 focus:ring-[#103020] transition-colors"
              />
            </div>
          </div>

          <!-- Row 2: Phone & Position Applied For -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                Contact Number <span class="text-[#9b1b2e]">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="e.g. +91 9876543210"
                class="w-full px-3.5 py-2.5 text-sm bg-[#fdfdfd] border border-gray-300 rounded-none outline-none focus:border-[#103020] focus:ring-1 focus:ring-[#103020] transition-colors"
              />
            </div>

            <div>
              <label for="position" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                Post Applied For <span class="text-[#9b1b2e]">*</span>
              </label>
              <input
                type="text"
                id="position"
                name="position"
                required
                placeholder="e.g. PGT Physics, TGT English, Warden"
                class="w-full px-3.5 py-2.5 text-sm bg-[#fdfdfd] border border-gray-300 rounded-none outline-none focus:border-[#103020] focus:ring-1 focus:ring-[#103020] transition-colors"
              />
            </div>
          </div>

          <!-- Experience / Qualifications & Cover Note -->
          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
              Qualifications & Experience Summary <span class="text-[#9b1b2e]">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="State your academic qualifications, years of teaching/administrative experience, and any relevant links..."
              class="w-full px-3.5 py-2.5 text-sm bg-[#fdfdfd] border border-gray-300 rounded-none outline-none focus:border-[#103020] focus:ring-1 focus:ring-[#103020] transition-colors resize-y"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="career-submit-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 text-sm font-bold text-white bg-[#9b1b2e] hover:bg-[#7a1524] rounded-none transition-all duration-200 shadow-sm"
            >
              Apply Today &rarr;
            </button>
            <div id="career-result" class="mt-4 text-sm font-medium"></div>
          </div>
        </form>
      </div>

    </div>
  </main>

  <Footer phone1={phone1} phone2={phone2} email={email} />
</BaseLayout>

<script>
  const form = document.getElementById("career-form") as HTMLFormElement | null;
  const result = document.getElementById("career-result") as HTMLElement | null;
  const submitBtn = document.getElementById("career-submit-btn") as HTMLButtonElement | null;

  if (form && result && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      result.className = "mt-4 text-xs sm:text-sm font-medium text-gray-600 bg-gray-100 p-3 border border-gray-200";
      result.innerHTML = "Submitting application...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();
        if (data.success) {
          result.className = "mt-4 text-xs sm:text-sm font-bold text-emerald-800 bg-emerald-50 border border-emerald-300 p-3";
          result.innerHTML = "Application Submitted Successfully! Our administrative team will review your profile.";
          form.reset();
        } else {
          result.className = "mt-4 text-xs sm:text-sm font-bold text-red-800 bg-red-50 border border-red-300 p-3";
          result.innerHTML = data.message || "Failed to submit application. Please try again later.";
        }
      } catch (err) {
        result.className = "mt-4 text-xs sm:text-sm font-bold text-red-800 bg-red-50 border border-red-300 p-3";
        result.innerHTML = "Network error. Please check your connection and try again.";
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>