---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Anjuman-I-Islam Public School & Jr. College"
  description="Contact Anjuman-I-Islam Public School and Jr. College in Panchgani."
>
  <main class="mx-auto w-full max-w-5xl px-6 py-16">
    <div class="max-w-3xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-amber-400">We are here to help</p>
      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">Contact the school</h1>
      <p class="mt-6 text-xl leading-8 text-slate-300">
        Reach out to our team for admissions guidance, campus information, or questions about student life.
      </p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <section class="border border-slate-800 bg-slate-900/70 p-6">
        <h2 class="text-lg font-semibold text-white">Visit</h2>
        <p class="mt-3 leading-7 text-slate-300">Anjuman-I-Islam Public School & Jr. College<br />Panchgani, Maharashtra, India</p>
      </section>
      <section class="border border-slate-800 bg-slate-900/70 p-6">
        <h2 class="text-lg font-semibold text-white">Admissions</h2>
        <p class="mt-3 leading-7 text-slate-300">For admission enquiries and current application information, please contact the school office.</p>
      </section>
      <section class="border border-slate-800 bg-slate-900/70 p-6">
        <h2 class="text-lg font-semibold text-white">Online</h2>
        <p class="mt-3 leading-7 text-slate-300">Send us a message and include the student’s class or programme so we can direct your enquiry.</p>
      </section>
    </div>

    <section class="mt-10 max-w-2xl border border-slate-800 bg-slate-900/70 p-6 sm:p-8">
      <h2 class="text-2xl font-semibold text-white">Send an enquiry</h2>
      <form class="mt-6 space-y-5" action="mailto:school@anjuman-islam.example" method="post" enctype="text/plain">
        <label class="block text-sm font-medium text-slate-200" for="name">
          Your name
          <input class="mt-2 w-full border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-amber-400" id="name" name="name" required />
        </label>
        <label class="block text-sm font-medium text-slate-200" for="email">
          Email address
          <input class="mt-2 w-full border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-amber-400" id="email" name="email" type="email" required />
        </label>
        <label class="block text-sm font-medium text-slate-200" for="message">
          Message
          <textarea class="mt-2 min-h-36 w-full border border-slate-700 bg-slate-950 px-4 py-3 text-white outline-none focus:border-amber-400" id="message" name="message" required></textarea>
        </label>
        <button class="bg-amber-400 px-5 py-3 font-bold text-slate-950 hover:bg-amber-300" type="submit">Send enquiry</button>
      </form>
    </section>
  </main>

</BaseLayout>
