---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const phone1 = "8275204302";
const phone2 = "8275205404";
const email = "anjumanpanchgani@gmail.com";

const contactCards = [
  {
    title: "Admissions Office",
    subtitle: "New admissions, fee structures, & campus tours",
    details: [`Phone: ${phone1} / ${phone2}`, `Email: ${email}`],
    badge: "Admissions Desk"
  },
  {
    title: "Campus Administration",
    subtitle: "General institutional inquiries & official correspondence",
    details: ["Mon. – Sat. : 9:00 AM – 5:00 PM", "Panchgani, District Satara, Maharashtra 412805"],
    badge: "Main Office"
  },
  {
    title: "Hostel & Student Welfare",
    subtitle: "Residential boarding care & parent visitation inquiries",
    details: ["Parent Visitations: Last Sunday of every month", "Dormitory communication via desk extension"],
    badge: "Residential Life"
  }
];
---

<BaseLayout
  title="Contact Us | Anjuman-I-Islam Public School & Jr. College, Panchgani"
  description="Get in touch with Anjuman-I-Islam Public School & Jr. College, Panchgani. Plan your campus visit, reach our admissions desk, or submit an online inquiry."
>
  <Header phone1={phone1} phone2={phone2} email={email} />

  <!-- Hero Header -->
  <section class="w-full bg-[#8b1d2c] text-white py-16 sm:py-20 px-4 sm:px-6 text-center border-b border-[#721522]">
    <div class="max-w-3xl mx-auto">
      <span class="inline-block text-xs uppercase tracking-[0.25em] text-red-200 font-semibold mb-4">
        Reach Our Campus &bull; Panchgani
      </span>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold tracking-tight text-white mb-4 leading-tight">
        Contact &amp; Visit Us
      </h1>
      <p class="text-sm sm:text-base text-red-100 max-w-2xl mx-auto font-light leading-relaxed">
        Whether you are planning an admission visit or have questions about our residential boarding curriculum, our team is here to assist you.
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <main class="w-full max-w-[1180px] mx-auto px-4 sm:px-6 py-14 space-y-16">

    <!-- 1. Key Office Department Cards -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {contactCards.map((card) => (
        <div class="bg-white rounded-3xl border border-slate-200/80 p-7 shadow-sm flex flex-col justify-between hover:border-slate-300 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-widest text-[#8b1d2c] bg-red-50 border border-red-100 px-3 py-1 rounded-full">
                {card.badge}
              </span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#8b1d2c]"></span>
            </div>
            <h3 class="font-serif text-xl font-bold text-[#0d1b2a] mb-1.5">
              {card.title}
            </h3>
            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
              {card.subtitle}
            </p>
            <div class="space-y-1 text-xs sm:text-sm text-slate-700">
              {card.details.map((line) => (
                <p class="font-medium">{line}</p>
              ))}
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- 2. Interactive Form & Location Map Section -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Inquiry Form (7 Cols) -->
      <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200/80 p-7 sm:p-10 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-widest text-[#8b1d2c] block mb-1">
          Direct Message
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#0d1b2a] tracking-tight border-b border-slate-100 pb-4 mb-6">
          Send Us an Inquiry
        </h2>

        <form action="/submit-contact" method="POST" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="full_name" class="block text-xs font-semibold text-slate-600 mb-1.5">Your Full Name *</label>
              <input 
                type="text" 
                id="full_name" 
                name="full_name" 
                required 
                class="w-full border border-slate-200 rounded-xl p-3 text-sm bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8b1d2c]/20 focus:border-[#8b1d2c]" 
                placeholder="e.g., Tariq Khan" 
              />
            </div>
            <div>
              <label for="contact_phone" class="block text-xs font-semibold text-slate-600 mb-1.5">Phone Number *</label>
              <input 
                type="tel" 
                id="contact_phone" 
                name="contact_phone" 
                required 
                class="w-full border border-slate-200 rounded-xl p-3 text-sm bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8b1d2c]/20 focus:border-[#8b1d2c]" 
                placeholder="+91 98765 43210" 
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact_email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email Address *</label>
              <input 
                type="email" 
                id="contact_email" 
                name="contact_email" 
                required 
                class="w-full border border-slate-200 rounded-xl p-3 text-sm bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8b1d2c]/20 focus:border-[#8b1d2c]" 
                placeholder="name@domain.com" 
              />
            </div>
            <div>
              <label for="inquiry_type" class="block text-xs font-semibold text-slate-600 mb-1.5">Inquiry Type *</label>
              <select 
                id="inquiry_type" 
                name="inquiry_type" 
                required 
                class="w-full border border-slate-200 rounded-xl p-3 text-sm bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8b1d2c]/20 focus:border-[#8b1d2c]"
              >
                <option value="">Select Category</option>
                <option value="admission">Admission for 2026–2027</option>
                <option value="junior-college">Junior College (Science / Commerce)</option>
                <option value="campus-visit">Schedule Campus Tour</option>
                <option value="general">General Administrative Query</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-slate-600 mb-1.5">Your Message *</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required 
              class="w-full border border-slate-200 rounded-xl p-3 text-sm bg-slate-50/60 focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#8b1d2c]/20 focus:border-[#8b1d2c]" 
              placeholder="Please provide details regarding your query, student's current standard, or desired visit date..."
            ></textarea>
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              class="inline-flex items-center justify-center px-8 py-3.5 text-xs sm:text-sm font-bold text-white bg-[#8b1d2c] hover:bg-[#721522] rounded-full transition-all duration-200 shadow-sm hover:shadow active:scale-[0.98]"
            >
              <span>Send Message</span>
              <span class="ml-1.5">&rarr;</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Campus Directions & Embedded Map (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white rounded-3xl border border-slate-200/80 p-7 sm:p-8 shadow-sm space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-[#0d1b2a] block">
            Visiting the Campus
          </span>
          <h3 class="font-serif text-xl font-bold text-[#0d1b2a]">
            How to Reach Us
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Our 174-acre residential campus is located in the scenic hills of Panchgani, Maharashtra. The campus is well-connected by road from Pune (approx. 100 km) and Mumbai (approx. 250 km) via the NH 48 highway corridor.
          </p>

          <div class="pt-2 flex flex-wrap gap-2.5">
            <a
              href={`tel:${phone1}`}
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-[#8b1d2c] hover:bg-[#721522] rounded-full transition-all duration-200 shadow-sm"
            >
              <span>Call Admissions</span>
            </a>
            <a
              href="https://maps.google.com/?q=anjuman-i-islam+public+school+panchgani"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-full transition-colors"
            >
              <span>Open in Google Maps &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Embedded Map Container -->
        <div class="w-full h-80 rounded-3xl overflow-hidden border border-slate-200/90 shadow-sm bg-slate-900 relative">
          <iframe
            title="Anjuman-I-Islam Public School Panchgani Campus Map"
            src="https://www.google.com/maps?sca_esv=c3fa94b0e0973b9d&rlz=1C1CFYW_en-GBIN1175IN1175&output=embed&q=anjuman-i-islam+public+school+panchgani"
            class="w-full h-full border-0 absolute inset-0"
            loading="lazy"
            allowfullscreen=""
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

    </section>

  </main>

  <Footer phone1={phone1} phone2={phone2} email={email} />
</BaseLayout>