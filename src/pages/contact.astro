---
// src/pages/contact.astro
const title = "Contact Us – Anjuman-I-Islam Public School & Jr. College";
const description = "Get in touch with Anjuman-I-Islam Public School & Jr. College, Panchgani. Find our contact details, campus address, and admission inquiry form.";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>

  <!-- Top Bar -->
  <div class="topbar">
    <div class="container">
      <span>Welcome to Anjuman-I-Islam Public School & Jr. College</span>
      <div class="topbar-links">
        <a href="/admissions">Admissions</a>
        <a href="/academics">Academics</a>
        <a href="/campus-life">Campus Life</a>
        <a href="/contact" class="active">Contact</a>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="header">
    <div class="container">
      <a href="/" class="logo">
        <div class="logo-icon">A</div>
        <div class="logo-text">
          <span>Public School & Jr. College</span>
          <strong>ANJUMAN-I-ISLAM</strong>
        </div>
      </a>

      <nav class="nav">
        <a href="/">Home</a>
        <a href="/about">About Us</a>
        <a href="/academics">Academics</a>
        <a href="/admissions">Admissions</a>
        <a href="/facilities">Facilities</a>
        <a href="/contact" class="active">Contact</a>
      </nav>

      <div class="header-actions">
        <button class="search-btn" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
        <a href="/admissions" class="btn btn-primary btn-sm">Apply Now →</a>
        <button class="nav-toggle" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Page Banner -->
  <section class="page-banner">
    <div class="page-banner-content">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Contact</span>
      </div>
      <h1>Contact Us</h1>
      <p>Reach out to Anjuman-I-Islam Public School & Jr. College, Panchgani. We welcome all inquiries regarding admissions, campus visits, and academics.</p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="page-content">
    <div class="container">

      <!-- Info cards -->
      <div class="contact-info-grid">
        <!-- Phone Card -->
        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h3>Call Us</h3>
          <p><a href="tel:+918275204302">+91 82752-04302</a></p>
          <p><a href="tel:+918275205404">+91 827520-5404</a></p>
        </div>

        <!-- Email Card -->
        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <h3>Email Us</h3>
          <p><a href="mailto:anjumanpanchgani@gmail.com">anjumanpanchgani@gmail.com</a></p>
          <p style="color: #666; font-size: 0.9rem;">General & Admission Inquiries</p>
        </div>

        <!-- Address Card -->
        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3>Walk in at</h3>
          <p>Anjuman-I-Islam Public School,<br>Panchgani-Mahabaleshwar Road,<br>Taluka Mahabaleshwar, Dist. Satara,<br>Pincode: 412805</p>
        </div>

        <!-- Campus / Code Card -->
        <div class="contact-info-card">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <h3>Location Plus Code</h3>
          <p><strong>WQH9+37</strong></p>
          <p>Nandanwan, Panchgani, Pangari, Maharashtra 412805</p>
        </div>
      </div>

      <!-- Form + Map -->
      <div class="contact-main">
        <div class="contact-form-wrap">
          <h2>Get in Touch</h2>
          <p>Have questions regarding admissions, boarding facilities, or academics? Send us a message and our administration will get back to you promptly.</p>

          <!-- Web3Forms Form -->
          <form id="form">
            <input type="hidden" name="access_key" value="927b4f37-3d99-458b-924c-1ff5af739f20" />
            <input type="hidden" name="from_name" value="Anjuman Website Contact Form" />

            <div class="form-row">
              <div class="form-group">
                <label for="name">Full Name *</label>
                <input type="text" id="name" name="name" placeholder="Your full name" required />
              </div>
              <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" required />
              </div>
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" rows="5" placeholder="How can we assist you?" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Submit Form →</button>
            <div id="result" style="margin-top: 15px; font-weight: 500;"></div>
          </form>
        </div>

        <!-- Satellite View Map -->
        <div class="contact-map">
          <iframe
            title="Anjuman-i-Islam Public School & Jr. College Satellite Location"
            src="https://maps.google.com/maps?q=Anjuman-I-Islam+Public+School+Panchgani&t=k&z=17&ie=UTF8&iwloc=&output=embed"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            style="width:100%; height:100%; min-height:420px; border:0; border-radius: 8px;"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <h2>Begin Your Journey With Anjuman-I-Islam</h2>
      <p>Experience holistic education and character building in the serene hills of Panchgani.</p>
      <a href="/admissions" class="btn btn-white">Apply for Admission →</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo">
            <div class="logo-icon">A</div>
            <div class="logo-text">
              <span style="color: rgba(255,255,255,0.6)">Public School & Jr. College</span>
              <strong style="color:#fff">ANJUMAN-I-ISLAM</strong>
            </div>
          </a>
          <p>Empowering young minds with education, discipline, and moral values for a successful future.</p>
        </div>
        <div>
          <h4>Quick Links</h4>
          <div class="footer-links">
            <a href="/about">About Us</a>
            <a href="/academics">Academics</a>
            <a href="/admissions">Admissions</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div>
          <h4>Academics</h4>
          <div class="footer-links">
            <a href="/primary">Primary School</a>
            <a href="/secondary">Secondary School</a>
            <a href="/junior-college">Junior College</a>
            <a href="/hostel">Hostel & Boarding</a>
          </div>
        </div>
        <div>
          <h4>Contact Info</h4>
          <div class="footer-links">
            <a href="#">Panchgani-Mahabaleshwar Road, Satara</a>
            <a href="tel:+918275204302">+91 82752-04302</a>
            <a href="mailto:anjumanpanchgani@gmail.com">anjumanpanchgani@gmail.com</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Anjuman-I-Islam Public School & Jr. College. All rights reserved.</span>
      </div>
    </div>
  </footer>

  <!-- Web3Forms Submission Script -->
  <script>
    const form = document.getElementById("form") as HTMLFormElement;
    const result = document.getElementById("result") as HTMLElement;

    if (form && result) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        result.style.color = "#3b82f6";
        result.innerHTML = "Sending message...";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: new FormData(form),
          });

          const data = await response.json();
          if (data.success) {
            result.style.color = "#16a34a";
            result.innerHTML = "Thank you! Your message has been sent successfully.";
            form.reset();
          } else {
            result.style.color = "#dc2626";
            result.innerHTML = data.message || "Something went wrong. Please try again.";
          }
        } catch (error) {
          result.style.color = "#dc2626";
          result.innerHTML = "Error submitting form. Please check your connection.";
        }
      });
    }
  </script>

</body>
</html>