---
// src/pages/contact.astro
const title = "Contact – Anjuman-I-Islam Public School & Jr. College";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-gray-50 text-gray-800 font-['Inter',sans-serif] antialiased flex flex-col min-h-screen">

  <!-- Top Bar -->
  <div class="bg-slate-900 text-slate-300 text-xs py-2.5 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2">
      <span>Welcome to Anjuman-I-Islam Public School & Jr. College</span>
      <div class="flex items-center space-x-6">
        <a href="#" class="hover:text-white transition-colors">Tuition & Fee</a>
        <a href="#" class="hover:text-white transition-colors">How To Apply</a>
        <a href="#" class="hover:text-white transition-colors">Requirements</a>
        <a href="/contact" class="text-white font-medium">Contact</a>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-xl shadow-sm">
          A
        </div>
        <div class="flex flex-col">
          <span class="text-xs text-gray-500 uppercase tracking-wider font-semibold">Public School & Jr. College</span>
          <strong class="text-lg font-bold text-gray-900 leading-tight">ANJUMAN-I-ISLAM</strong>
        </div>
      </a>

      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-gray-600">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <a href="#" class="hover:text-blue-600 transition-colors">About Us</a>
        <a href="#" class="hover:text-blue-600 transition-colors">Academics</a>
        <a href="#" class="hover:text-blue-600 transition-colors">Admissions</a>
        <a href="/contact" class="text-blue-600 font-semibold">Contact</a>
      </nav>

      <div class="flex items-center space-x-4">
        <a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors shadow-sm">
          Apply Now →
        </a>
      </div>
    </div>
  </header>

  <!-- Page Banner -->
  <section class="bg-slate-900 text-white py-16 md:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-2xl">
      <div class="flex items-center justify-center space-x-2 text-xs text-slate-400 uppercase tracking-wider font-medium mb-3">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-blue-400">Contact</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">Get In Touch</h1>
      <p class="text-slate-300 text-base leading-relaxed">
        Education goes beyond textbooks and classrooms. Reach out to our campus administration for inquiries, admissions, or visits.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <main class="flex-grow py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Info Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        
        <!-- Call Us -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-gray-200 transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Call Us</h3>
          <p class="text-sm text-gray-600 mb-1"><a href="tel:+918275204302" class="hover:text-blue-600 transition-colors">+91 82752-04302</a></p>
          <p class="text-sm text-gray-600"><a href="tel:+918275205404" class="hover:text-blue-600 transition-colors">+91 827520-5404</a></p>
        </div>

        <!-- Email Us -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-gray-200 transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Email Us</h3>
          <p class="text-sm text-gray-600 break-all"><a href="mailto:anjumanpanchgani@gmail.com" class="hover:text-blue-600 transition-colors">anjumanpanchgani@gmail.com</a></p>
          <span class="text-xs text-gray-400 mt-2">General Inquiries</span>
        </div>

        <!-- Walk in at -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-gray-200 transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Walk in at</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Anjuman-I-Islam Public School,<br />
            Panchgani-Mahabaleshwar Road, Tal. Mahabaleshwar, Dist. Satara 412805
          </p>
        </div>

        <!-- Campus Location -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-gray-200 transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Campus Code</h3>
          <p class="text-sm font-semibold text-gray-800">WQH9+37</p>
          <p class="text-sm text-gray-600 mt-1">Nandanwan, Panchgani, Maharashtra 412805</p>
        </div>
      </div>

      <!-- Form + Satellite Map -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Contact Form Box -->
        <div class="lg:col-span-6 bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Send us a Message</h2>
            <p class="text-sm text-gray-600 mb-8">Fill out the form below and our administrative office will get in touch with you shortly.</p>

            <form id="form" class="space-y-5">
              <input type="hidden" name="access_key" value="927b4f37-3d99-458b-924c-1ff5af739f20" />

              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Full Name *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  placeholder="Enter your name" 
                  required 
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all bg-gray-50/50"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email Address *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  placeholder="name@example.com" 
                  required 
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all bg-gray-50/50"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Message *</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="4" 
                  placeholder="Write your inquiry here..." 
                  required 
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all bg-gray-50/50 resize-none"
                ></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full sm:w-auto px-7 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg text-sm transition-colors shadow-sm cursor-pointer"
              >
                Submit Form
              </button>
            </form>
          </div>

          <div id="result" class="text-sm font-medium pt-4"></div>
        </div>

        <!-- Google Map Satellite View Box -->
        <div class="lg:col-span-6 min-h-[420px] rounded-2xl overflow-hidden shadow-sm border border-gray-100 bg-gray-100">
          <iframe
            title="Anjuman-i-Islam Public School Satellite Location"
            src="https://maps.google.com/maps?q=Anjuman-i-Islam+Public+School+%26+Jr.+College,+Panchgani&t=k&z=17&ie=UTF8&iwloc=&output=embed"
            class="w-full h-full min-h-[420px] border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>

    </div>
  </main>

  <!-- CTA -->
  <section class="bg-blue-600 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">Begin Your Journey With Anjuman-I-Islam</h2>
      <p class="text-blue-100 text-sm md:text-base mb-6 max-w-xl mx-auto">Providing academic excellence and holistic student development in Panchgani.</p>
      <a href="#" class="inline-flex items-center px-6 py-2.5 bg-white text-blue-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors text-sm shadow">
        Apply Now →
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-slate-400 py-12 text-sm border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <div>
        <p class="text-white font-semibold mb-1">Anjuman-I-Islam Public School & Jr. College, Panchgani</p>
        <p class="text-xs text-slate-500">Panchgani-Mahabaleshwar Road, Satara 412805</p>
      </div>
      <div class="text-xs text-slate-500">
        © 2026 Anjuman-I-Islam. All rights reserved.
      </div>
    </div>
  </footer>

  <!-- Web3Forms Submission Script -->
  <script>
    const form = document.getElementById("form") as HTMLFormElement | null;
    const result = document.getElementById("result") as HTMLElement | null;

    if (form && result) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        result.className = "text-sm font-medium pt-4 text-blue-600";
        result.innerHTML = "Sending...";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: new FormData(form),
          });

          const data = await response.json();
          if (data.success) {
            result.className = "text-sm font-medium pt-4 text-green-600";
            result.innerHTML = "Form Submitted Successfully";
            form.reset();
          } else {
            result.className = "text-sm font-medium pt-4 text-red-600";
            result.innerHTML = data.message || "Something went wrong.";
          }
        } catch (err) {
          result.className = "text-sm font-medium pt-4 text-red-600";
          result.innerHTML = "Error sending message. Please try again.";
        }
      });
    }
  </script>

</body>
</html>