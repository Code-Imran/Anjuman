---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Administration | Anjuman-I-Islam" description="Anjuman-I-Islam administration area.">
  <main class="flex min-h-screen items-center justify-center px-6 py-16">
    <section class="w-full max-w-2xl border border-slate-800 bg-slate-900/80 p-8 shadow-2xl sm:p-10">
      <a href="/" class="text-sm text-amber-300 hover:text-amber-200">&lt;- Back to website</a>
      <p class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-amber-400">Administration</p>
      <h1 class="mt-3 text-3xl font-bold text-white">Welcome to the school office</h1>
      <p id="admin-message" class="mt-4 leading-7 text-slate-300">Checking your session...</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="bg-amber-400 px-5 py-3 font-bold text-slate-950 hover:bg-amber-300" href="/contact">View enquiries</a>
        <button id="signout-button" class="border border-slate-700 px-5 py-3 font-semibold text-slate-200 hover:border-amber-400 hover:text-amber-300" type="button">Sign out</button>
      </div>
    </section>
  </main>

  <script>
    import { supabase } from '../lib/supabase';

    const message = document.querySelector('#admin-message');
    const signoutButton = document.querySelector('#signout-button');

    if (!supabase) {
      message.textContent = 'Authentication is not configured. Add the Supabase keys before using the administration area.';
      signoutButton.hidden = true;
    } else {
      const { data } = await supabase.auth.getSession();
      if (!data.session) {
        window.location.href = '/login';
      } else {
        message.textContent = `Signed in as ${data.session.user.email}.`;
      }

      signoutButton.addEventListener('click', async () => {
        signoutButton.disabled = true;
        const { error } = await supabase.auth.signOut();
        if (error) {
          message.textContent = error.message;
          signoutButton.disabled = false;
          return;
        }
        window.location.href = '/login';
      });
    }
  </script>
</BaseLayout>
