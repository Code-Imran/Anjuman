---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Anjuman-I-Islam Public School & Jr. College">
  <main>
    <section class="home-hero">
      <div class="home-hero__content">
        <p class="eyebrow">An independent school community in Panchgani</p>
        <h1>Learning with purpose. Growing with confidence.</h1>
        <p class="home-hero__intro">Anjuman-I-Islam Public School &amp; Jr. College gives young people the knowledge, character, and curiosity to shape a meaningful future.</p>
        <div class="home-hero__actions">
          <a class="button button--primary" href="/admission-requirements">Explore admissions</a>
          <a class="button button--quiet" href="/about">Discover our story</a>
        </div>
      </div>
      <div class="home-hero__note">
        <span class="home-hero__note-number">01</span>
        <span>Academic excellence<br />with a human touch</span>
      </div>
    </section>

    <section class="home-intro">
      <div>
        <p class="eyebrow">A place to belong</p>
        <h2>Education that reaches beyond the classroom.</h2>
      </div>
      <div class="home-intro__copy">
        <p>Our school brings together thoughtful teaching, a caring community, and the confidence to ask better questions. We help every student find their strengths and take their next step with purpose.</p>
        <a class="text-link" href="/about">More about our school <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="home-pillars" aria-label="What makes our school special">
      <article><span>01</span><h3>Strong foundations</h3><p>Learning that builds confidence in the classroom and beyond.</p></article>
      <article><span>02</span><h3>Curious minds</h3><p>Space to explore ideas, develop talents, and think independently.</p></article>
      <article><span>03</span><h3>Shared values</h3><p>A respectful community where character matters as much as achievement.</p></article>
    </section>

    <section class="home-admissions">
      <div>
        <p class="eyebrow">Begin the conversation</p>
        <h2>Find the right next step for your child.</h2>
      </div>
      <div>
        <p>Learn about the documents, process, and support available to families considering Anjuman-I-Islam.</p>
        <a class="button button--light" href="/admission-requirements">View admission requirements</a>
      </div>
    </section>
  </main>
</BaseLayout>
