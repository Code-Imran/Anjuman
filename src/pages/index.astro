---
import Layout from '/src/layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import SchoolGlance from '../components/SchoolGlance.astro';
import Leadership from '../components/Leadership.astro';
import NewsSection from '../components/NewsSection.astro';
import AcademicWings from '../components/AcademicWings.astro';
import Heritage from '../components/Heritage.astro';
import VirtualTour from '../components/VirtualTour.astro';
import CoCurricular from '../components/CoCurricular.astro';
import Testimonials from '../components/Testimonials.astro';
import ImageGallery from '../components/ImageGallery.astro';
import AdmissionsCTA from '../components/AdmissionsCTA.astro';
import Footer from '../components/Footer.astro';
import FloatingSocial from '../components/FloatingSocial.astro';

// SEO & Contact Defaults
const metaTitle = "Anjuman-I-Islam Public School & Jr. College, Panchgani";
const metaDescription = "Premier English Medium Residential Co-Ed Boarding School in Panchgani since 1920. Academic excellence, equestrian sports, and holistic character building.";
const keywords = ["Anjuman Panchgani", "Residential School Panchgani", "Boarding School Maharashtra", "ICSE School"];

const contactPhone1 = "8275204302";
const contactPhone2 = "8275205404";
const contactEmail = "anjumanpanchgani@gmail.com";
const fallbackImage = "/images/gallery/Anjuman Public School Panchgani.webp";

const recentPosts = [
  {
    title: "Centenary Heritage & Legacy in the Hills",
    date: "September 2026",
    category: "Campus Life",
    excerpt: "Nurturing generations of leaders with an emphasis on moral character, discipline, and academic distinction.",
    slug: "heritage-legacy",
    image: fallbackImage
  },
  {
    title: "State-of-the-Art Science & Digital Learning Labs",
    date: "August 2026",
    category: "Academics",
    excerpt: "Upgraded technological infrastructure providing experiential learning across all academic wings.",
    slug: "academic-upgrades",
    image: fallbackImage
  },
  {
    title: "Equestrian & Athletics Excellence Program",
    date: "July 2026",
    category: "Sports",
    excerpt: "Holistic development through expansive sporting grounds, gymnasium, and dedicated horse-riding tracks.",
    slug: "sports-program",
    image: fallbackImage
  }
];

const testimonialsList = [
  {
    name: "Dr. Farooq Siddiqui",
    relation: "Parent of Class X Student",
    quote: "The discipline, care, and peaceful hill environment of Panchgani have nurtured our son into a self-reliant, confident young scholar.",
    avatar: fallbackImage
  },
  {
    name: "Mrs. Shabana Merchant",
    relation: "Parent of Junior College Scholar",
    quote: "A true second home. The faculty and hostel staff provide unmatched pastoral care alongside exceptional academic standards.",
    avatar: fallbackImage
  }
];

const galleryItems = [
  {
    src: fallbackImage,
    alt: "Historic Campus Heritage Building Panchgani",
    title: "Historic Campus",
    category: "Campus"
  },
  {
    src: fallbackImage,
    alt: "Equestrian Ground and Sports Arena",
    title: "Sports & Riding Arena",
    category: "Sports"
  },
  {
    src: fallbackImage,
    alt: "Modern Boarding School Dormitories",
    title: "Hostel Living",
    category: "Hostel"
  }
];
---

<Layout 
  title={metaTitle}
  metaTitle={metaTitle}
  description={metaDescription}
  metaDescription={metaDescription}
  keywords={keywords}
>
  <Header 
    phone1={contactPhone1} 
    phone2={contactPhone2} 
    email={contactEmail} 
  />
  
  <HeroSlider />
  
  <SchoolGlance />
  
  <Leadership />
  
  <NewsSection recentPosts={recentPosts} />
  
  <AcademicWings />
  
  <Heritage />
  
  <VirtualTour />
  
  <CoCurricular />
  
  <Testimonials testimonials={testimonialsList} />
  
  <ImageGallery items={galleryItems} />
  
  <AdmissionsCTA phone={contactPhone1} />
  
  <Footer 
    phone1={contactPhone1} 
    phone2={contactPhone2} 
    email={contactEmail} 
  />
  
  <FloatingSocial phone={contactPhone1} />
</Layout>