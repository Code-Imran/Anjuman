---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSlider from '../components/HeroSlider.astro';
import SchoolGlance from '../components/SchoolGlance.astro';
import Leadership from '../components/Leadership.astro';
import VirtualTour from '../components/VirtualTour.astro';
import ImageGallery from '../components/ImageGallery.astro';
import CoCurricular from '../components/CoCurricular.astro';
import NewsSection from '../components/NewsSection.astro';
import Footer from '../components/Footer.astro';
import FloatingSocial from '../components/FloatingSocial.astro';

const phone1 = "8275204302";
const phone2 = "8275205404";
const email = "anjumanpanchgani@gmail.com";
---

<BaseLayout
  title="Anjuman-I-Islam Public School & Jr. College, Panchgani"
  description="English Medium Residential Co-Ed School & Junior College established in 1920 in Panchgani, Maharashtra. Affiliated with Maharashtra State Board (SSC & HSC)."
>
  <!-- Global Navigation Header -->
  <Header phone1={phone1} phone2={phone2} email={email} />

  <main>
    <!-- 1. Hero Slider with Cinematic Zoom -->
    <HeroSlider />

    <!-- 2. School at a Glance Animated Counter Stats -->
    <SchoolGlance />

    <!-- 3. Leadership Messages with Full Square Portraits -->
    <Leadership />

    <!-- 4. Virtual Campus Tour Video Embed -->
    <VirtualTour />

    <!-- 5. Campus Visual Gallery Grid -->
    <ImageGallery />

    <!-- 6. Co-Curricular Institutional Pillars -->
    <CoCurricular />

    <!-- 7. Latest News Continuous Marquee Slider -->
    <NewsSection />

    <!-- 8. Admissions Open CTA Block (Univet Crimson #8f1d2c Styling) -->
    <section class="bg-[#8f1d2c] text-white py-20 px-6 text-center border-t border-[#7a1524]" aria-label="Admissions Call to Action">
      <div class="max-w-4xl mx-auto flex flex-col items-center">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
          Admissions Open
        </h2>
        
        <p class="mt-4 text-base sm:text-lg text-white/90 max-w-2xl mx-auto leading-relaxed">
          Join a century-old tradition of academic excellence in Panchgani. Enquire about seats for the upcoming academic year.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <!-- Primary Pill Button -->
          <a
            href="/admission#general-instructions-for-parents"
            class="inline-flex items-center justify-center px-7 py-3 text-sm sm:text-base font-semibold text-[#8f1d2c] bg-white rounded-full transition-all duration-200 shadow-md hover:bg-white/90 hover:shadow-lg hover:-translate-y-0.5"
          >
            View Admission Requirements &rarr;
          </a>

          <!-- Secondary Call Button -->
          <a
            href={`tel:${phone1}`}
            class="inline-flex items-center justify-center px-7 py-3 text-sm sm:text-base font-semibold text-white bg-transparent border-2 border-white rounded-full transition-all duration-200 hover:bg-white hover:text-[#8f1d2c]"
          >
            Call {phone1}
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Global Footer & Floating Widget -->
  <Footer phone1={phone1} phone2={phone2} email={email} />
  <FloatingSocial phone={phone1} />
</BaseLayout>