---
import '../styles/global.css';

interface Props {
  title?: string;
  metaTitle?: string;
  description?: string;
  metaDescription?: string;
  keywords?: string[];
}

const {
  title = "Anjuman-I-Islam Public School & Jr. College",
  metaTitle,
  description = "Panchgani, Maharashtra - Excellence in Education",
  metaDescription,
  keywords = [],
} = Astro.props;

const pageTitle = metaTitle || title;
const pageDescription = metaDescription || description;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-slate-900 text-white min-h-screen flex flex-col justify-between">
    <slot />
  </body>
</html>
