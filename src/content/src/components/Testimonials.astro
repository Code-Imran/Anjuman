---
import { reader } from '../lib/keystatic-reader';

interface Testimonial {
  name: string;
  relation: string;
  quote: string;
  avatar: string;
}
interface Props {
  testimonials?: Testimonial[];
}

let { testimonials } = Astro.props;

if (!testimonials) {
  const entries = await reader.collections.testimonials.all();
  testimonials = entries.map((e) => ({
    name: e.entry.name,
    relation: e.entry.relation,
    quote: e.entry.quote,
    avatar: e.entry.avatar,
  }));
}
---

<section class="py-16 px-6 max-w-5xl mx-auto">
  <h2 class="font-serif text-2xl md:text-3xl text-white text-center">What Parents Say</h2>

  <div class="mt-10 grid sm:grid-cols-2 gap-6">
    {testimonials.map((t) => (
      <blockquote class="p-6 rounded-lg border border-slate-800 bg-slate-900">
        <p class="text-slate-300 leading-relaxed">"{t.quote}"</p>
        <footer class="mt-4 flex items-center gap-3">
          <img src={t.avatar} alt={t.name} class="w-10 h-10 rounded-full object-cover" onerror="this.style.display='none'" />
          <div>
            <p class="text-white text-sm font-medium">{t.name}</p>
            <p class="text-slate-500 text-xs">{t.relation}</p>
          </div>
        </footer>
      </blockquote>
    ))}
  </div>
</section>
